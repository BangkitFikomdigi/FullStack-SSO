# ===== Server =====
PORT=3000

# ===== PostgreSQL Database =====
# Ganti dengan kredensial PostgreSQL lokal Anda
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sso_auth
DB_SSL=false

# ===== Session & Token Configuration =====
SESSION_PENDING_MINUTES=5
SESSION_ACTIVE_MINUTES=15
REFRESH_TOKEN_DAYS=7
